<launch>
  <arg name="cloud_topic" default="/cloud_registered"/>
  <arg name="odom_topic" default="/Odometry"/>
  <arg name="map_frame" default="camera_init"/>
  <arg name="use_dynablox" default="true"/>
  <arg name="use_tsdf" default="false"/>
  <arg name="input_cloud_in_world" default="true"/>

  <node pkg="raycast_static_map" type="raycast_static_map_node"
        name="raycast_static_map" output="screen">
    <rosparam command="load" file="$(find raycast_static_map)/config/fastlio.yaml"/>
    <param name="cloud_topic" value="$(arg cloud_topic)"/>
    <param name="odom_topic" value="$(arg odom_topic)"/>
    <param name="map_frame" value="$(arg map_frame)"/>
    <param name="use_dynablox" value="$(arg use_dynablox)"/>
    <param name="use_tsdf" value="$(arg use_tsdf)"/>
    <param name="input_cloud_in_world" value="$(arg input_cloud_in_world)"/>
  </node>
</launch>

